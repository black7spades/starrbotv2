# StarrBot v2 Docker Environment
# Copy this to .env and fill in your values

# Your public URL (required for Discord OAuth redirect)
# e.g. https://bot.yourdomain.com or http://localhost:2013
BASE_URL=

# Discord OAuth (required for guild detection + Login with Discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=info

# Security secrets. The Docker entrypoint generates these when unset; if you
# run outside Docker you MUST set them, or the app falls back to well-known
# development secrets and anyone can forge an admin session.
# Names must match exactly — the app reads JWT_ACCESS_SECRET, not JWT_SECRET.
# JWT_ACCESS_SECRET=your-access-secret-here
# JWT_REFRESH_SECRET=your-refresh-secret-here
# COOKIE_SECRET=your-cookie-secret-here

# Instagram session cookie for the RSSHub container (treat like a password)
# INSTAGRAM_COOKIE=

# Optional: RSSHub URL (if running RSSHub externally)
# RSSHUB_URL=https://your-rsshub.example.com