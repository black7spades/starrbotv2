# StarrBot v2 Docker Environment
# Copy this to .env and fill in your values

# Security secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
COOKIE_SECRET=your-cookie-secret-here

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=info

# Optional: RSSHub URL (if running RSSHub externally)
# RSSHUB_URL=https://your-rsshub.example.com

# Optional: Discord OAuth (for future features)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=